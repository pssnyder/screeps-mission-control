rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access to analytics data
    match /telemetry_daily/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Admin-only access to all other collections
    match /dev_sessions/{document} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /console_history/{document} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /system_state/{document} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /screeps_docs/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /ai_usage/{document} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    match /ai_costs/{document} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    match /ai_actions/{document} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
