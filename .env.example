# Environment Configuration for Screeps Mission Control

# Screeps Credentials
SCREEPS_EMAIL=your_email@example.com
SCREEPS_PASSWORD=your_password_here
SCREEPS_TOKEN=your_api_token_here

# Or use token authentication (recommended)
# Get token from: https://screeps.com/a/#!/account/auth-tokens
# SCREEPS_TOKEN=your_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Screeps Server (default: official server)
SCREEPS_HOST=https://screeps.com
SCREEPS_PORT=443
SCREEPS_SECURE=true

# Primary Room to Monitor
DEFAULT_ROOM=W13N57
DEFAULT_SHARD=shard3

# Update Intervals (milliseconds)
# REDUCED DEFAULTS TO AVOID API RATE LIMITING
# Telemetry: CPU, bucket, energy gauges
TELEMETRY_UPDATE_INTERVAL=10000
# Status: Creeps, construction, structures  
STATUS_UPDATE_INTERVAL=30000

# Note: Dashboard telemetry is updated in-game every 100 ticks (~5 min)
# These intervals just poll the cached data from Memory.dashboard
# If you see rate limit errors, increase these values or enable no-rate-limit:
# https://screeps.com/a/#!/account/auth-tokens/noratelimit
